# Copy to ~/.env and fill in real values. ~/.env is NOT tracked in git.
# Sourced automatically by ~/.zshrc on every shell startup (see `set -a; source ~/.env`).

# DataCamp teach-api cookie (JWT) — used by the transform-google-skills-courses skill.
TEACH_API_COOKIE=

# Atlassian / Jira API token — create at https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=

# Anthropic Claude Code OAuth token — set by `claude login` or pulled from keychain.
CLAUDE_CODE_OAUTH_TOKEN=

# DataCamp private npm registry auth token.
NPM_TOKEN=

# PhraseApp (translations) access token — used by the translations skill.
PHRASE_ACCESS_TOKEN=

# GitHub PAT used by Bundler for private github.com repos (underscore maps to a dot).
BUNDLE_GITHUB__COM=
